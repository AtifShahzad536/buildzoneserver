PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# MongoDB Connection
MONGO_URI=mongodb://127.0.0.1:27017/buildzone

# JWT Authentication
JWT_SECRET=your_super_secret_jwt_key_here_at_least_32_characters
JWT_EXPIRE=7d

# Cloudinary CDN Configuration
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Gmail SMTP Email Notification Credentials
EMAIL_SERVICE=gmail
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_gmail_app_password
EMAIL_FROM="BuildZone Inquiries <your_email@gmail.com>"
ADMIN_NOTIFICATION_EMAIL=admin@buildzone.tech
